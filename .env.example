# ─── Required ────────────────────────────────────────────────────────────────
# TMDB credentials. Either a v3 API key or a v4 "API Read Access Token" (eyJ...).
TMDB_API_KEY=
# Bot token from @BotFather. Used to verify Telegram initData and sign sessions.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID. Every other user gets a 404.
# "*" allows any Telegram user (initData is still verified; non-Telegram visitors get 404).
ALLOWED_TELEGRAM_USER_ID=
# Playback source you are authorized to use. Two supported forms:
#   1) Template URL with placeholders, e.g.
#        PLAYBACK_PROVIDER_URL=https://media.example.com/movies/{tmdbId}.m3u8
#        PLAYBACK_PROVIDER_TV_URL=https://media.example.com/tv/{tmdbId}/{season}/{episode}.mp4
#      Placeholders: {type} (movie|tv), {tmdbId}, {season}, {episode}
#      PLAYBACK_PROVIDER_TV_URL defaults to PLAYBACK_PROVIDER_URL.
#   2) JSON resolver base URL (no placeholders), e.g. https://resolver.example.com/api
#        GET {base}/movie/{tmdbId}                 -> { "url", "type", "title" }
#        GET {base}/tv/{tmdbId}/{season}/{episode} -> { "url", "type", "title" }
#      404 => not available.
# Leave empty to disable playback (the rest of the app still works).
PLAYBACK_PROVIDER_URL=

# ─── Optional ────────────────────────────────────────────────────────────────
# PLAYBACK_PROVIDER_TV_URL=           # template-mode TV URL (defaults to PLAYBACK_PROVIDER_URL)
# PLAYBACK_PROVIDER_TOKEN=            # sent as "Authorization: Bearer <token>" to a JSON resolver
# PLAYBACK_SOURCE_TYPE=               # force iframe|hls|mp4 in template mode (default: inferred)
# TMDB_REGION=UZ                      # ISO 3166-1 region for release dates / watch providers
# TMDB_LANGUAGE=en-US                 # TMDB response language
# DEV_BYPASS_AUTH=true                # `next dev` only: skip Telegram auth. Ignored in production.
# TMDB_API_BASE_URL=http://localhost:4055  # `next dev` only: point TMDB calls at a local mock.
